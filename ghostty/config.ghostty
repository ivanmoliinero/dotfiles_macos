# --- FUENTE Y TEXTO ---
font-family = "JetBrains Mono"
font-size = 14
font-thicken = true

# --- TEMA ---
theme = Atom One Dark

# --- VENTANA Y DISEÑO ---
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = hidden

# --- COMPORTAMIENTO ---
clipboard-read = allow
clipboard-write = allow
scrollback-limit = 100000

# --- ATAJOS DE TECLADO ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+t=new_window
keybind = global:alt+shift+t=toggle_quick_terminal

keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+j=goto_split:down

# --- DOCK ICON ---
macos-icon = custom
macos-custom-icon = /Applications/Ghostty.app/Contents/Resources/Ghostty.icns